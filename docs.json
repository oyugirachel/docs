{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ZenVeil",
  "colors": {
    "primary": "#A78BFA",
    "light": "#C4B5FD",
    "dark": "#7C3AED"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "why-zenveil",
              "quickstart",
              "installation",
              "how-it-works"
            ]
          },
          {
            "group": "Scanners",
            "pages": [
              "scanners/secrets",
              "scanners/supply-chain",
              "scanners/api-headers",
              "scanners/cicd"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/github",
              "integrations/gitlab",
              "integrations/slack",
              "integrations/ci-cd"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/secret-detection",
              "examples/ai-remediation",
              "examples/devsecops-workflow",
              "examples/owasp-findings"
            ]
          },
          {
            "group": "Plans & Pricing",
            "pages": [
              "plans"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "CLI Reference",
            "pages": [
              "cli/overview",
              "cli/scan",
              "cli/list",
              "cli/explain",
              "cli/fix",
              "cli/triage",
              "cli/agent",
              "cli/report",
              "cli/stats",
              "cli/ignore",
              "cli/feedback"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/scan-github",
              "api-reference/scan-api",
              "api-reference/explain",
              "api-reference/fix",
              "api-reference/fix-pr",
              "api-reference/triage"
            ]
          }
        ]
      },
      {
        "tab": "Security",
        "groups": [
          {
            "group": "Security",
            "pages": [
              "security/philosophy",
              "security/data-privacy",
              "security/api-key-handling",
              "security/responsible-disclosure"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/zenveil/zenveil",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/zenveil",
          "icon": "discord"
        },
        {
          "anchor": "Status",
          "href": "https://status.zenveil.dev",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/zenveil-light.svg",
    "dark": "/logo/zenveil-dark.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "image": "/images/background.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.zenveil.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start Free",
      "href": "https://app.zenveil.dev/signup"
    }
  },
  "footer": {
    "socials": {
      "twitter": "https://twitter.com/zenveil",
      "github": "https://github.com/zenveil/zenveil",
      "linkedin": "https://linkedin.com/company/zenveil"
    }
  },
  "integrations": {
    "posthog": {
      "apiKey": "phc_YOUR_KEY"
    }
  }
}